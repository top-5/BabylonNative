# Pure preflight state tests; no fixture checkout, source copy, or source mutation.
include("${CMAKE_CURRENT_LIST_DIR}/ApplyRuntimeDiagnostics.cmake")
set(_head "980cfb0197f7fda661d362df4b275cff42d1e7f2")
set(_base "070999a8d8d4f1976c7c0a0ebaa6b3339a46ac241ab34f2713fc6f352d37370e")
set(_patched "fcf49995306681e688d0ded3c1cabdd3a65dfa054eb98c7686220b7bc5ece4e2")

if(DEFINED FAILURE_CASE)
    if(FAILURE_CASE STREQUAL "head")
        runtime_diagnostics_plan(ON "0000000000000000000000000000000000000000" "${_base}" _unused)
    elseif(FAILURE_CASE STREQUAL "foreign_on")
        runtime_diagnostics_plan(ON "${_head}" "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff" _unused)
    elseif(FAILURE_CASE STREQUAL "foreign_off")
        runtime_diagnostics_plan(OFF "${_head}" "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff" _unused)
    elseif(FAILURE_CASE STREQUAL "mode")
        runtime_diagnostics_plan(AUTO "${_head}" "${_base}" _unused)
    elseif(FAILURE_CASE STREQUAL "missing_hash")
        runtime_diagnostics_plan(ON "${_head}" "" _unused)
    else()
        message(FATAL_ERROR "Unknown test case")
    endif()
    message(FATAL_ERROR "A refusal case unexpectedly returned")
endif()

set(_checks 0)
function(expect_action mode hash expected)
    runtime_diagnostics_plan("${mode}" "${_head}" "${hash}" _actual)
    if(NOT _actual STREQUAL expected)
        message(FATAL_ERROR "Expected ${expected}, got ${_actual}")
    endif()
    math(EXPR _next "${_checks} + 1")
    set(_checks "${_next}" PARENT_SCOPE)
endfunction()
function(expect_refusal case pattern)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DFAILURE_CASE=${case}" -P "${CMAKE_CURRENT_FUNCTION_LIST_FILE}"
        RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _error)
    if(_result STREQUAL "0" OR NOT "${_error}" MATCHES "${pattern}")
        message(FATAL_ERROR "Guard refusal ${case} did not fail for its intended reason: ${_out}${_error}")
    endif()
    math(EXPR _next "${_checks} + 1")
    set(_checks "${_next}" PARENT_SCOPE)
endfunction()

expect_action(ON "${_base}" APPLY)
expect_action(ON "${_patched}" NONE)
expect_action(OFF "${_base}" NONE)
expect_action(OFF "${_patched}" REVERSE)
expect_action(on "${_base}" APPLY)
expect_refusal(head "Unsupported JsRuntimeHost HEAD")
expect_refusal(foreign_on "Unrecognized AppRuntime.cpp content")
expect_refusal(foreign_off "Unrecognized AppRuntime.cpp content")
expect_refusal(mode "Unsupported runtime diagnostics mode")
expect_refusal(missing_hash "Unrecognized AppRuntime.cpp content")
message(STATUS "RuntimeDiagnosticsPatchGuard: ${_checks} checks, 0 failures (no source writes)")
