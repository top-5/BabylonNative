# Pinned single-file opt-in instrumentation. No checkout reset, stash, index write,
# network operation, or untracked source copy is used. Unknown source edits refuse.
# Include API: apply_runtime_diagnostics(<existing JsRuntimeHost checkout> ON|OFF)
# CLI: cmake -DSOURCE_DIR=<checkout> -DMODE=ON|OFF -P <this file>

function(runtime_diagnostics_plan mode head source_sha out_action)
    string(TOUPPER "${mode}" _mode)
    string(TOLOWER "${head}" _head)
    string(TOLOWER "${source_sha}" _sha)
    if(NOT _mode STREQUAL "ON" AND NOT _mode STREQUAL "OFF")
        message(FATAL_ERROR "Unsupported runtime diagnostics mode: use ON or OFF")
    endif()
    if(NOT _head STREQUAL "980cfb0197f7fda661d362df4b275cff42d1e7f2")
        message(FATAL_ERROR "Unsupported JsRuntimeHost HEAD; runtime diagnostics will not modify it")
    endif()
    set(_base "070999a8d8d4f1976c7c0a0ebaa6b3339a46ac241ab34f2713fc6f352d37370e")
    set(_patched "fcf49995306681e688d0ded3c1cabdd3a65dfa054eb98c7686220b7bc5ece4e2")
    if(_sha STREQUAL _base)
        if(_mode STREQUAL "ON")
            set(_action APPLY)
        else()
            set(_action NONE)
        endif()
    elseif(_sha STREQUAL _patched)
        if(_mode STREQUAL "OFF")
            set(_action REVERSE)
        else()
            set(_action NONE)
        endif()
    else()
        message(FATAL_ERROR "Unrecognized AppRuntime.cpp content; preserving foreign edits, no patch action")
    endif()
    set(${out_action} "${_action}" PARENT_SCOPE)
endfunction()

function(apply_runtime_diagnostics source_dir mode)
    if(NOT IS_DIRECTORY "${source_dir}" OR NOT EXISTS "${source_dir}/.git")
        message(FATAL_ERROR "Runtime diagnostics requires the existing tracked JsRuntimeHost checkout")
    endif()
    find_package(Git REQUIRED QUIET)
    file(REAL_PATH "${source_dir}" _root)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${_root}" rev-parse --show-toplevel
        OUTPUT_VARIABLE _git_root OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _result)
    if(NOT _result STREQUAL "0")
        message(FATAL_ERROR "Cannot resolve the runtime diagnostics checkout root")
    endif()
    file(REAL_PATH "${_git_root}" _git_root)
    if(NOT _git_root STREQUAL _root)
        message(FATAL_ERROR "Runtime diagnostics source must be the checkout root, not another working directory")
    endif()
    set(_relative "Core/AppRuntime/Source/AppRuntime.cpp")
    set(_target "${_root}/${_relative}")
    if(NOT EXISTS "${_target}" OR IS_SYMLINK "${_target}")
        message(FATAL_ERROR "Runtime diagnostics target must be a normal tracked source file")
    endif()
    file(REAL_PATH "${_target}" _target_real)
    if(NOT _target_real STREQUAL _target)
        message(FATAL_ERROR "Runtime diagnostics refuses a redirected source path")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${_root}" ls-files --error-unmatch -- "${_relative}"
        RESULT_VARIABLE _result OUTPUT_QUIET ERROR_QUIET)
    if(NOT _result STREQUAL "0")
        message(FATAL_ERROR "Runtime diagnostics target is not tracked by this checkout")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${_root}" rev-parse HEAD
        OUTPUT_VARIABLE _head OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _result)
    if(NOT _result STREQUAL "0")
        message(FATAL_ERROR "Cannot read JsRuntimeHost HEAD for runtime diagnostics")
    endif()
    file(SHA256 "${_target}" _before)
    runtime_diagnostics_plan("${mode}" "${_head}" "${_before}" _action)
    set(_patch "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/AppRuntime-dispatch.patch")
    if(NOT EXISTS "${_patch}")
        message(FATAL_ERROR "Pinned runtime diagnostics patch is missing")
    endif()
    file(SHA256 "${_patch}" _patch_sha)
    if(NOT _patch_sha STREQUAL "00f0c35fba272f861bfac4ddadd4c708fba100dd779bbfca6724e9b2ec7f7c65")
        message(FATAL_ERROR "Runtime diagnostics patch identity changed; refusing source writes")
    endif()
    if(_action STREQUAL "NONE")
        message(STATUS "Runtime diagnostics patch already matches requested mode ${mode}")
        return()
    endif()
    set(_reverse)
    set(_expected "fcf49995306681e688d0ded3c1cabdd3a65dfa054eb98c7686220b7bc5ece4e2")
    if(_action STREQUAL "REVERSE")
        set(_reverse --reverse)
        set(_expected "070999a8d8d4f1976c7c0a0ebaa6b3339a46ac241ab34f2713fc6f352d37370e")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${_root}" apply --check ${_reverse} "${_patch}"
        RESULT_VARIABLE _result ERROR_VARIABLE _error)
    if(NOT _result STREQUAL "0")
        message(FATAL_ERROR "Runtime diagnostics patch preflight failed, no source change: ${_error}")
    endif()
    # Recheck immediately before the write; other dirty paths are never enumerated,
    # reset, or discarded. The caller serializes this existing source/build window.
    file(SHA256 "${_target}" _rechecked)
    if(NOT _rechecked STREQUAL _before)
        message(FATAL_ERROR "Runtime diagnostics source changed during preflight; no patch action")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${_root}" apply ${_reverse} "${_patch}"
        RESULT_VARIABLE _result ERROR_VARIABLE _error)
    if(NOT _result STREQUAL "0")
        message(FATAL_ERROR "Runtime diagnostics patch failed: ${_error}")
    endif()
    file(SHA256 "${_target}" _after)
    if(NOT _after STREQUAL _expected)
        message(FATAL_ERROR "Runtime diagnostics post-patch hash differs; inspect the source, do not reset foreign work")
    endif()
    message(STATUS "Runtime diagnostics ${_action}: ${_relative}, SHA256 ${_after}")
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    if(NOT DEFINED SOURCE_DIR OR NOT DEFINED MODE)
        message(FATAL_ERROR "Usage: cmake -DSOURCE_DIR=<existing checkout> -DMODE=ON|OFF -P ApplyRuntimeDiagnostics.cmake")
    endif()
    apply_runtime_diagnostics("${SOURCE_DIR}" "${MODE}")
endif()
